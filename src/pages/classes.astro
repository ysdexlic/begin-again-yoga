---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ClassCard from '../components/ClassCard.astro';
import classes from '../data/classes.json';
---

<Base
  title="Classes · Begin Again Yoga"
  description="Vinyasa flow, pranayama and meditation — Begin Again Yoga's small-group classes, for every body and every level."
>
  <section class="wrap head">
    <SectionLabel text="Classes" />
    <h1>Classes</h1>
  </section>

  <section class="wrap types">
    <h2 class="visually-hidden">Class types</h2>
    <div class="cards">
      {classes.map((c) => <ClassCard {...c} />)}
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 6vw, 5rem) 2.5rem;
    text-align: center;
  }

  .head h1 {
    margin-inline: auto;
  }

  .types {
    padding-block: 0 var(--space-section);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 47.99rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
