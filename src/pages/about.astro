---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import HillDivider from '../components/HillDivider.astro';
import { href } from '../lib/href';
import site from '../data/site.json';

const philosophy = [
  {
    icon: 'sprout',
    title: 'Growth',
    text: 'Small steps, taken kindly, add up. Progress here is quieter than a headstand — it sounds like breathing a little easier.',
  },
  {
    icon: 'heart',
    title: 'Self Love',
    text: "You practice with the body you have today. Nothing to fix, nothing to prove — you're met exactly where you are.",
  },
  {
    icon: 'circle',
    title: 'Breathe',
    text: 'An hour that belongs to you. Put the week down at the door; it will keep.',
  },
] as const;
---

<Base
  title="About · Begin Again Yoga"
  description="Ardita Biru Langit's story behind Begin Again Yoga — starting over without judgment, one breath at a time. Yoga Alliance Certified, 200hr YTT."
>
  <section class="wrap head">
    <SectionLabel text="About" />
    <h1>Begin again, every day</h1>
  </section>

  <section class="wrap story">
    <div class="story-text">
      <h2>Why &ldquo;Begin Again&rdquo;</h2>
      <!-- Ardita's own words — edit only with her. -->
      <div class="prose">
        <p>My journey to yoga was not a straight line.</p>
        <p>
          There was a point in my life when I realised I needed to choose
          myself. I walked away from a marriage that was no longer healthy for
          me, I left my stable job and started a new chapter in a new city.
        </p>
        <p>
          It was scary. I didn't know exactly what my future would look like,
          and for a while, I didn't know who I was becoming either.
        </p>
        <p>But I had my mat.</p>
        <p>I kept coming back to it.</p>
        <p>
          Sometimes I came to the mat feeling strong. Sometimes I came feeling
          lost, tired, or uncertain. But every time I stepped onto it, I had a
          moment to breathe, to slow down, and to listen to myself.
        </p>
        <p>
          I began to realise that yoga wasn't asking me to be perfect. It was
          simply teaching me to meet myself where I was.
        </p>
        <p>And slowly, I started to feel like myself again.</p>
        <p class="pull">
          For me, returning to the mat means returning to myself.
        </p>
        <p>
          It is a reminder that life doesn't have to look the way we once
          imagined. That starting over is not failure. That we are allowed to
          change direction, to let go, and to begin again.
        </p>
        <p>This is why I created Begin Again Yoga.</p>
        <p>
          A space for movement, breath, and connection. A space where you
          don't have to be flexible, strong, or experienced. You simply have
          to show up as you are.
        </p>
        <p>
          Because sometimes, the bravest thing we can do is take one small
          step forward.
        </p>
        <p>And sometimes, that step begins on the mat.</p>
        <p>
          Welcome to Begin Again Yoga.<br />
          A place to pause, reconnect, and begin again.
        </p>
        <p class="byline">&mdash; {site.teacher}</p>
      </div>
    </div>
    <PhotoPlaceholder label="Photo — TODO" />
  </section>

  <HillDivider />

  <section class="wrap philosophy">
    <h2 class="center">How this practice feels</h2>
    <ul class="blocks" role="list">
      {
        philosophy.map((p) => (
          <li>
            <Icon name={p.icon} size={30} />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap trainings">
    <div class="trainings-text">
      <h2>Trainings &amp; background</h2>
      <p class="cert">
        <span class="cert-icon"><Icon name="sprout" size={22} /></span>
        <span>{site.certification}</span>
      </p>
    </div>
    <PhotoPlaceholder label="Photo — TODO" />
  </section>

  <section class="wrap closing">
    <p class="script closing-line">Come as you are.</p>
    <Button href={href('/contact/')}>Get in touch</Button>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
    text-align: center;
  }

  .head h1 {
    margin-inline: auto;
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: calc(var(--space-section) / 1.5);
  }

  .story p,
  .trainings p {
    max-width: 55ch;
  }

  .prose {
    display: grid;
    gap: 1em;
    margin-top: 1.25rem;
  }

  /* Her one-line refrain, set apart — sage-deep on cream is AA (BRAND §2) */
  .pull {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h3);
    line-height: 1.35;
    color: var(--sage-deep);
    padding-block: 0.375rem;
  }

  .byline {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--sage-deep);
  }

  /* On sand, ink is the only approved reading color (BRAND §2) */
  .cert {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
    padding: 0.875rem 1.25rem;
    background: var(--sand);
    border-radius: var(--radius-card);
    font-weight: 500;
    color: var(--ink);
  }

  .cert-icon {
    display: flex;
    flex-shrink: 0;
    color: var(--sage-deep);
  }

  .philosophy {
    padding-block: calc(var(--space-section) / 1.5);
  }

  .center {
    text-align: center;
  }

  .blocks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .blocks li {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.625rem;
    color: var(--sage-deep);
  }

  .blocks p {
    color: var(--ink);
    font-size: var(--text-small);
  }

  .trainings {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 240px);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: calc(var(--space-section) / 1.5) 0;
  }

  .closing {
    display: grid;
    justify-items: center;
    gap: 2.25rem;
    padding-block: var(--space-section) 0;
    text-align: center;
  }

  .closing-line {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--sage-deep);
  }

  @media (max-width: 47.99rem) {
    .story,
    .trainings,
    .blocks {
      grid-template-columns: 1fr;
    }

    .story,
    .trainings {
      justify-items: center;
      text-align: center;
    }

    /* Long-form reading, heading included, stays left-aligned on small screens */
    .story-text {
      text-align: left;
    }
  }
</style>
