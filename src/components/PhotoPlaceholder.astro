---
/**
 * Organic photo frame (BRAND §5: organic blobs, never hard rectangles).
 * Given a `src`, renders the photo via astro:assets cropped to a soft blob
 * shape; without one, stays an obvious placeholder.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  label?: string;
  src?: ImageMetadata;
  alt?: string;
}

const { label = 'Photo — TODO', src, alt = '' } = Astro.props;
---

<figure class:list={['blob-frame', { 'has-photo': !!src }]}>
  {
    src ? (
      <Image class="photo" src={src} alt={alt} width={400} densities={[1, 2]} />
    ) : (
      <>
        <svg viewBox="0 0 200 200" width="200" height="200" aria-hidden="true">
          <path
            class="blob"
            d="M100 12c30 0 62 10 76 34 14 25 8 58-6 82s-38 42-68 42-58-16-74-42S10 66 26 42 70 12 100 12Z"
          ></path>
        </svg>
        <figcaption><span class="todo">{label}</span></figcaption>
      </>
    )
  }
</figure>

<style>
  .blob-frame {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 320px);
  }

  .blob-frame svg {
    width: 100%;
    height: auto;
  }

  .blob {
    fill: var(--sand);
  }

  .has-photo {
    overflow: hidden;
    border-radius: 54% 46% 58% 42% / 48% 55% 45% 52%;
    /* Keeps Safari clipping the scaled photo to the rounded frame */
    isolation: isolate;
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    transform: scale(1.25);
    transform-origin: 50% 88%;
  }

  figcaption {
    position: absolute;
    font-size: var(--text-small);
  }
</style>
