---
/**
 * One pricing option (data from src/data/pricing.json). Prices stay as
 * visible TODO chips until the owner supplies them — never invented.
 */
interface Props {
  name: string;
  price: string;
  detail: string;
}

const { name, price, detail } = Astro.props;
---

<article class="card">
  <h3>{name}</h3>
  <p class="price" aria-label={`Price: ${price}`}>
    <span class="todo">{price}</span>
  </p>
  <p class="detail">{detail}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--taupe);
    border-radius: var(--radius-card);
  }

  .price {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--terracotta-ink);
  }

  .price .todo {
    font-size: 1.125rem;
  }

  .detail {
    font-size: var(--text-small);
  }
</style>
