---
/**
 * Weekly schedule (data from src/data/schedule.json). Until the owner
 * supplies the real timetable the seed row renders as an explicit
 * "coming soon" placeholder, and the note above the table says so.
 */
import schedule from '../data/schedule.json';
---

<p class="note">{schedule.note}</p>

<div class="table-scroll">
  <table>
    <caption class="visually-hidden">Weekly class schedule</caption>
    <thead>
      <tr>
        <th scope="col">Day</th>
        <th scope="col">Time</th>
        <th scope="col">Class</th>
        <th scope="col">Location</th>
      </tr>
    </thead>
    <tbody>
      {
        schedule.rows.map((row) => (
          <tr>
            <td><span class="todo">{row.day}</span></td>
            <td><span class="todo">{row.time}</span></td>
            <td>{row.class}</td>
            <td><span class="todo">{row.location}</span></td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .note {
    font-size: var(--text-small);
    margin-bottom: 1rem;
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  th {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sage-deep);
    text-align: left;
  }

  th,
  td {
    padding: 0.75rem 1rem 0.75rem 0;
    border-bottom: 1px solid var(--taupe);
  }
</style>
